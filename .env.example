# Copiez ce fichier en ".env.local" et remplissez les vraies valeurs
# (voir README_DEPLOIEMENT.md pour savoir où les trouver).

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optionnelle aujourd'hui (non utilisée par le code de l'application) : clé
# d'administration Supabase, pour un futur script serveur/admin. Jamais
# préfixée "NEXT_PUBLIC_", jamais envoyée au navigateur.
SUPABASE_SERVICE_ROLE_KEY=

# Nécessaire uniquement pour l'assistant IA de reformulation de texte.
# GRATUIT : obtenez une clé sur https://aistudio.google.com/app/apikey (compte Google, aucune carte bancaire).
# Ne JAMAIS mettre "NEXT_PUBLIC_" devant : elle doit rester secrète, côté serveur uniquement.
# Selon la date de création, la clé commence par "AIza..." ou par le nouveau format "AQ...".
GEMINI_API_KEY=AQ...
